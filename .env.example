# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=uj_connect
DB_PORT=3306

# Auth
JWT_SECRET=change_this_to_a_long_random_secret_string
SESSION_SECRET=change_this_too_a_different_random_secret

# School email domain restriction (used for signup validation)
SCHOOL_EMAIL_DOMAIN=gmail.com

# Admin bootstrap (used once by init-db to create the first admin account)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=UJ Connect Admin
ADMIN_PHONE=0000000000

# Two-Factor Authentication (TOTP) has no extra config needed —
# it works fully offline with any authenticator app (Google Authenticator,
# Authy, Microsoft Authenticator, 1Password, etc). See README for details.

# Email OTP verification (registration flow) — sent via Nodemailer/SMTP.
# Works with Gmail (use an App Password, not your real password), Outlook,
# SendGrid's SMTP relay, or Mailtrap (recommended for local dev/testing).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM="UJ Connect <no-reply@ujconnect.app>"

# Secret used to HMAC-hash OTP codes before storing them (never store plain codes).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PEPPER=change_this_to_a_long_random_secret_string

# Paystack payments and seller payouts
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
APP_BASE_URL=http://localhost:5000
# 0 basis points = 0% commission. 100 basis points = 1%.
PLATFORM_COMMISSION_BPS=0
